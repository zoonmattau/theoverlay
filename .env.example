# Form King Modellers API. Without it the site runs on the sample card.
FORMKING_API_KEY=
OVERLAY_STATES=NSW,VIC,QLD
OVERLAY_SPEEDMAPS=0

# Supabase (Project settings > API). Without these, accounts are off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Use a restricted key (rk_) with Checkout, Customers, Billing Portal
# and Subscriptions access. Price ids come from one Product per plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SATURDAY=
STRIPE_PRICE_MIDWEEK=
STRIPE_PRICE_EVERYDAY=
# One Price with volume tiers matching PASS_BUNDLES in src/lib/billing/plans.ts.
STRIPE_PRICE_PASS=

# Used in emails and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 to unlock the whole site locally with no account.
OVERLAY_OPEN=0

# Transactional email through Resend. Without a key, emails are logged and skipped.
RESEND_API_KEY=
EMAIL_FROM="The Overlay <hello@theoverlay.com.au>"

# Vercel sends this as a bearer token on scheduled calls to /api/cron/*.
CRON_SECRET=

# Affiliate links by Form King bookie code, JSON. Unset codes link to the bookie home page.
# NEXT_PUBLIC_BOOKIE_LINKS={"sportsbet":"https://...","tab":"https://..."}

# Social log in, once the providers are enabled in Supabase Auth. Any of: google,twitter
# NEXT_PUBLIC_AUTH_PROVIDERS=google,twitter
