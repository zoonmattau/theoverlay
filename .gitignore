# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design-sync (claude.ai/design) staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/dist/
.design-sync/learnings/
.design-sync/node_modules

# Raw Form King responses, short-lived
.formking-cache/

# Screenshots dropped in the project root
/*.png
scripts/out/
__pycache__/
email-preview.html

# OBS recordings
/YouTube/
# YouTube video files live with the rest of the YouTube work in marketing/youtube, but never in git (5 Oct 2026).
/marketing/youtube/**/*.mp4
/marketing/youtube/**/*.mov
